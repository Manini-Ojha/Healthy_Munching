# Copy this file to .env and fill in your Razorpay TEST keys from
# https://dashboard.razorpay.com/app/keys (Test mode) to enable payments.
# Until these are set, checkout will show "Payment gateway not configured yet".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SESSION_SECRET=dev-secret-change-me

# Turso (hosted SQLite). Leave both empty for local dev — falls back to a
# local file at server/data.sqlite. Required in production (e.g. on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Redis (e.g. Upstash) backing express-session. Leave as-is for local dev if
# you have Redis running locally, or point it at your hosted instance.
REDIS_URL=redis://localhost:6379
